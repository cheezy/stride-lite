# OS cruft
.DS_Store
Thumbs.db

# Editor cruft
*.swp
*.swo
*~
.idea/
.vscode/

# Local secrets
.env
.env.local
*.local

# Full Stride plugin (which drives work in this checkout): its orchestrator
# marker directory and its bearer-token auth file. Never committed.
.stride/
.stride_auth.md

# stride-lite orchestrator activation marker (transient session state).
# Deliberately NOT .stride/ — that directory belongs to the full Stride
# plugin and a project may have both installed.
.stride-lite/

# stride-exploratory-testing artifacts: session sheets, backlog, coverage, and
# the regression checks /harden stages. Transient working output, and a staged
# check lives OUTSIDE the test tree by design so the project's gate never runs
# it — committing them would defeat both properties.
.exploratory/
